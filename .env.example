# Copy to .env for local work. NEVER commit .env or real values.
# Source of truth for every variable: docs/architecture/deploy.md section 4.
# Legend: S = GitHub secret, V = GitHub variable, F = Edge Function secret, W = web build (public).
# Comments sit on their own lines: `supabase functions serve --env-file` does not strip inline ones.
# Empty values count as "not set".

# ---------------------------------------------------------------------------------------------
# Local stack (supabase start, then pnpm fn:serve)
# ---------------------------------------------------------------------------------------------
# local | test | production
APP_ENV=local
# git sha in CI and production
APP_VERSION=dev
# F. Local: the DB container name is supabase_db_<project_id>; seed.sql sets this role's local-only
# password. Production: the transaction pooler URL on port 6543 (deploy.yml builds it).
API_DB_URL=postgresql://haide_api:haide_api_local@supabase_db_haide:5432/postgres
# F, S. At least 16 chars. Header x-cron-secret for POST /internal/tick. Generate: openssl rand -base64 32
CRON_SECRET=
# F, S. At least 16 chars. Salt for the daily-rotating IP hash. Generate: openssl rand -base64 32
IP_HASH_SALT_SEED=
# F. Local development only: HS256 fallback for access tokens (at least 32 chars). Ignored in production.
LOCAL_JWT_SECRET=

# ---------------------------------------------------------------------------------------------
# Edge Function configuration (deploy.md 4.2)
# ---------------------------------------------------------------------------------------------
# F. fixture | ors
ROUTING_PROVIDER=fixture
# F, S. openrouteservice token, required when ROUTING_PROVIDER=ors
ORS_API_KEY=
# F. console | brevo
EMAIL_PROVIDER=console
# F, S. Required when EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM="Haide <no-reply@haide.ro>"
# F. Optional Reply-To header. Unset: replies go to EMAIL_FROM. Example: "Haide Support <support@haide.ro>"
EMAIL_REPLY_TO=
EMAIL_SUPPORT_TO=support@haide.ro
# tick stops sending at this many emails per day (the Brevo free cap is 300)
EMAIL_DAILY_CAP=280
APP_BASE_URL=http://localhost:5173
# Comma separated. Production: https://haide.ro,https://www.haide.ro
CORS_ORIGINS=http://localhost:5173
# Injected automatically by Supabase in the Edge Runtime. Set only when running the function elsewhere.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# F. Expected `iss` of access tokens. Empty: <SUPABASE_URL>/auth/v1 in production, http://127.0.0.1:54321/auth/v1 locally
JWT_ISSUER=
# F. Browser-reachable base for avatar URLs. Empty: <SUPABASE_URL>/storage/v1/object/public (production). Local: http://127.0.0.1:54321/storage/v1/object/public
AVATAR_PUBLIC_BASE_URL=
# E8 web push. F. All three or none. Generate once with `node scripts/vapid-keys.mjs`. Unset = push off
# (GET /push/config answers null, PUT /me/push-subscription 503, the tick skips the push step).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@haide.ro
# F. webpush | console. Default: webpush when the keys are set, else console (logs the push host only)
PUSH_PROVIDER=

# ---------------------------------------------------------------------------------------------
# Web build (public by design, baked into the bundle). Vite exposes only VITE_*.
# ---------------------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
# W. `supabase status` prints the local publishable (anon) key
VITE_SUPABASE_PUBLISHABLE_KEY=
# W. Empty = self-hosted PMTiles style. Fallback: https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=
VITE_APP_VERSION=dev

# ---------------------------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------------------------
# Set to http://127.0.0.1:54321/functions/v1/api/v1 to run `pnpm test:int` against the local stack
API_BASE_URL=
# Optional. Same value as CRON_SECRET above. Lets the integration suite call POST /internal/tick (expiry and email tests); those tests are skipped without it
# INT_DB_URL (default postgresql://postgres:postgres@127.0.0.1:54322/postgres) is the superuser DB the integration suite uses for expiry, blocks and invariant checks. INT_DB=skip skips them

# ---------------------------------------------------------------------------------------------
# Deploy and operations: GitHub Actions secrets/variables only (owner steps in deploy.md 3).
# Listed for completeness. Put real values in a local .env only if you run the CLI by hand.
# ---------------------------------------------------------------------------------------------
# S. Supabase CLI token (owner step 3)
SUPABASE_ACCESS_TOKEN=
# S. Database password of the production project (owner step 3)
SUPABASE_DB_PASSWORD=
# V. The xxxx in xxxx.supabase.co
SUPABASE_PROJECT_REF=
# S. Password of role haide_api in production (team-generated)
API_DB_PASSWORD=
# S. Google OAuth client (owner step 4). Local: only if you enable the provider in config.toml
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# S. Auth emails over SMTP (owner step 5)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# S. Pages edit token and account id (owner step 2)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# V. age1... public key for nightly backups (owner step 7)
BACKUP_AGE_PUBLIC_KEY=
# V. https://<ref>.supabase.co/functions/v1/api/v1 (activates keepalive.yml and backup.yml)
PROD_API_URL=
# V. Set to true only after GATE 3 (activates deploy.yml)
DEPLOY_ENABLED=
# Optional. Overpass endpoint for scripts/geo/build-gazetteer.ts
OVERPASS_URL=
# Optional. Pin a Protomaps build for scripts/geo/build-tiles.sh, e.g. 20261101.pmtiles
PROTOMAPS_BUILD=
